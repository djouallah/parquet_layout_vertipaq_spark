         "results_table": {
          "value": {
           "value": "@pipeline().parameters.results_table",
           "type": "Expression"
          },
          "type": "string"
         }
        }
       }
      }
     ]
    }
   }
  ],
  "parameters": {
   "ladder": {
    "type": "array",
