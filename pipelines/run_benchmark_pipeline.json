          "value": {
           "value": "@pipeline().parameters.models",
           "type": "Expression"
          },
          "type": "string"
         },
         "lh_name": {
          "value": {
           "value": "@pipeline().parameters.lh_name",
           "type": "Expression"
          },
          "type": "string"
         },
         "nbr_queries": {
          "value": {
           "value": "@pipeline().parameters.nbr_queries",
           "type": "Expression"
          },
          "type": "int"
         },
         "delay_sec": {
          "value": {
           "value": "@pipeline().parameters.delay_sec",
           "type": "Expression"
          },
          "type": "int"
         },
         "sf": {
          "value": {
           "value": "@pipeline().parameters.sf",
           "type": "Expression"
          },
          "type": "int"
         },
         "arms": {
          "value": {
           "value": "@pipeline().parameters.arms",
           "type": "Expression"
          },
          "type": "string"
         },
         "runs": {
          "value": {
           "value": "@item().runs",
           "type": "Expression"
          },
          "type": "int"
